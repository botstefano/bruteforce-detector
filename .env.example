# Local development only. Copy to .env and fill in secrets locally.
# Never commit .env or place server secrets in VITE_* variables.

NODE_ENV=development
PORT=3000

# Supabase project URL and server-side Secret API key (sb_secret_...).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Generate two independent random secrets (32+ bytes each).
CENTINELA_HASH_SECRET=
CENTINELA_INGEST_TOKEN=

# Dashboard login. SECRET_KEY signs expiring HttpOnly admin sessions.
DASHBOARD_PASSWORD=
SECRET_KEY=

# Only set this to the real number of trusted proxies in front of Express.
# Local development: 0. Render single proxy: 1.
TRUST_PROXY_HOPS=0

# Optional: exact browser origins if dashboard is hosted separately.
# Keep blank for same-origin deployment. Never use *.
ALLOWED_ORIGINS=

# Optional: demo-only credentials as JSON. Use test-only accounts.
CENTINELA_DEMO_CREDENTIALS_JSON={}

# Record versions used in the study.
CENTINELA_VERSION=research-capture-v1
CENTINELA_CONFIG_VERSION=1
