<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporte Científico Experimental — Centinela</title>
<meta name="description" content="Reporte de evaluación experimental y comparativa de rendimiento entre Heurística y Machine Learning frente a ataques de fuerza bruta.">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-base: #0B0F19;
    --bg-surface: #111827;
    --bg-surface-elevated: #1F2937;
    --border-subtle: #2D3748;
    --text-primary: #F3F4F6;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --brand-primary: #06B6D4;
    --brand-hover: #0891B2;
    --status-success: #10B981;
    --status-warning: #F59E0B;
    --status-danger: #EF4444;
    --status-info: #3B82F6;
    --status-purple: #8B5CF6;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    padding: 30px 20px;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
  }

  /* Barra de herramientas / Header */
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 14px 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .toolbar-title {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
  }

  .btn:hover {
    background: #2D3748;
    color: #fff;
  }

  .btn-primary {
    background: var(--brand-primary);
    color: #0B0F19;
    border-color: var(--brand-primary);
  }

  .btn-primary:hover {
    background: var(--brand-hover);
    color: #0B0F19;
  }

  /* Documento Científico */
  .doc-sheet {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .doc-header {
    border-bottom: 2px solid var(--border-subtle);
    padding-bottom: 24px;
    margin-bottom: 28px;
  }

  .badge-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: rgba(6, 182, 212, 0.12);
    color: var(--brand-primary);
    margin-bottom: 12px;
  }

  .doc-title {
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
  }

  .doc-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    background: rgba(0,0,0,0.25);
    padding: 14px 18px;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    font-size: 12.5px;
  }

  .meta-item b {
    color: #fff;
  }

  /* Secciones */
  .section {
    margin-bottom: 34px;
  }

  .section-title {
    font-size: 19px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-left: 4px solid var(--brand-primary);
    padding-left: 10px;
  }

  .section p {
    color: var(--text-secondary);
    font-size: 13.5px;
    margin-bottom: 12px;
  }

  /* Gráficas */
  .charts-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .charts-grid { grid-template-columns: 1fr; }
  }

  .chart-card {
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 20px;
  }

  .chart-title {
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Tabla de Resultados */
  .table-responsive {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    background: rgba(0,0,0,0.2);
    margin-bottom: 16px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  th {
    background: var(--bg-surface-elevated);
    color: #fff;
    padding: 12px 16px;
    font-weight: 700;
    border-bottom: 1px solid var(--border-subtle);
  }

  td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: var(--text-secondary);
  }

  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  .highlight-row td {
    background: rgba(6, 182, 212, 0.06);
    color: #fff;
    font-weight: 600;
  }

  .badge-val {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 11.5px;
    font-weight: 700;
  }
  .badge-val.high { background: rgba(16, 185, 129, 0.15); color: #34D399; }
  .badge-val.med  { background: rgba(245, 158, 11, 0.15); color: #FBBF24; }
  .badge-val.low  { background: rgba(239, 68, 68, 0.15);  color: #F87171; }

  /* Bloque de Código LaTeX */
  .code-box {
    background: #080C14;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #A5F3FC;
    overflow-x: auto;
    white-space: pre;
    position: relative;
    margin-top: 10px;
  }

  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
  }
  .copy-btn:hover { background: #374151; }

  /* Conclusiones callout */
  .callout {
    background: rgba(6, 182, 212, 0.07);
    border-left: 4px solid var(--brand-primary);
    border-radius: 0 8px 8px 0;
    padding: 16px 20px;
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-primary);
  }

  /* ESTILOS PARA IMPRESIÓN (PDF / PRINT) */
  @media print {
    body {
      background: #FFFFFF !important;
      color: #111827 !important;
      padding: 0 !important;
    }
    .toolbar, .copy-btn { display: none !important; }
    .doc-sheet {
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      background: #FFFFFF !important;
      color: #111827 !important;
    }
    .doc-title { color: #000000 !important; }
    .doc-subtitle { color: #4B5563 !important; }
    .section-title { color: #000000 !important; border-left-color: #000 !important; }
    .meta-grid { background: #F3F4F6 !important; border-color: #E5E7EB !important; color: #111827 !important; }
    .meta-item b { color: #000000 !important; }
    th { background: #E5E7EB !important; color: #000000 !important; border-bottom: 1px solid #9CA3AF !important; }
    td { color: #1F2937 !important; border-bottom: 1px solid #E5E7EB !important; }
    .chart-card { background: #FFFFFF !important; border: 1px solid #E5E7EB !important; }
    .chart-title { color: #000000 !important; }
    .code-box { background: #F8FAFC !important; color: #0F172A !important; border: 1px solid #CBD5E1 !important; }
    .callout { background: #F0FDF4 !important; border-left-color: #16A34A !important; color: #166534 !important; }
    .badge-val.high { background: #DCFCE7 !important; color: #15803D !important; }
    .badge-val.med  { background: #FEF3C7 !important; color: #B45309 !important; }
    .badge-val.low  { background: #FEE2E2 !important; color: #B91C1C !important; }
  }
</style>
</head>
<body>

<div class="container">
  
  <!-- BARRA DE ACCIONES SUPERIOR -->
  <div class="toolbar">
    <div class="toolbar-title">
      <span>📄 Reporte Científico Generado</span>
      <span style="font-size: 11px; font-weight: normal; color: var(--text-muted);">(Listo para imprimir o citar)</span>
    </div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <a href="/" class="btn">⬅️ Volver al Dashboard</a>
      <a href="/api/exportar_dataset?formato=csv" download class="btn">📥 Descargar Dataset (CSV)</a>
      <a href="/api/exportar_metricas?formato=latex" download class="btn">📑 Descargar LaTeX</a>
      <button onclick="window.print()" class="btn btn-primary">🖨️ Imprimir / Guardar en PDF</button>
    </div>
  </div>

  <!-- DOCUMENTO ESTILO PAPER -->
  <div class="doc-sheet">
    
    <div class="doc-header">
      <span class="badge-tag">Reporte de Evaluación Científica</span>
      <h1 class="doc-title">Evaluación Experimental: Detección Adaptativa de Fuerza Bruta (Heurística WAF vs. Machine Learning No Supervisado)</h1>
      <p class="doc-subtitle">Análisis comparativo de precisión, recall y resiliencia frente a ataques volumétricos, sigilosos (low-and-slow) y distribuidos (botnets).</p>
      
      <div class="meta-grid">
        <div class="meta-item"><span>Entorno:</span> <b>Centinela v2</b></div>
        <div class="meta-item"><span>Dataset Base de Entrenamiento:</span> <b>CICIDS2017 (<%= estadoModelo.fuente %>)</b></div>
        <div class="meta-item"><span>Total de Muestra ($N$):</span> <b><%= totalIntentos %> eventos evaluados</b></div>
        <div class="meta-item"><span>Fecha de Generación:</span> <b><%= new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></b></div>
      </div>
    </div>

    <% if (!metricas) { %>
      <div style="text-align: center; padding: 40px; color: var(--text-muted);">
        <h3>No hay eventos evaluados actualmente.</h3>
        <p style="margin-top: 8px;">Regresa al dashboard y haz clic en "⚡ N = 1,000 (Paper)" para generar la muestra de resultados.</p>
        <a href="/" class="btn btn-primary" style="margin-top: 16px;">Ir al Dashboard</a>
      </div>
    <% } else { %>

    <!-- SECCIÓN 1: GRÁFICAS COMPARATIVAS -->
    <div class="section">
      <div class="section-title">1. Gráficas Comparativas de Rendimiento</div>
      <p>Visualización del balance entre Precisión, Sensibilidad (Recall) y $F_1$-Score para cada técnica, contrastado con la composición del conjunto de prueba.</p>

      <div class="charts-grid">
        <!-- Gráfica de Barras -->
        <div class="chart-card">
          <div class="chart-title">
            <span>Comparativa de Métricas por Algoritmo</span>
            <span style="font-size: 11px; font-weight: normal; color: var(--text-muted);">Escala 0.0 - 1.0</span>
          </div>
          <div style="position: relative; height: 260px;">
            <canvas id="barChart"></canvas>
          </div>
        </div>

        <!-- Gráfica de Distribución de Muestra -->
        <div class="chart-card">
          <div class="chart-title">
            <span>Distribución de la Muestra ($N$)</span>
            <span style="font-size: 11px; font-weight: normal; color: var(--text-muted);"><%= totalIntentos %> eventos</span>
          </div>
          <div style="position: relative; height: 260px;">
            <canvas id="pieChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN 2: TABLA DE RESULTADOS -->
    <div class="section">
      <div class="section-title">2. Tabla Cuantitativa de Resultados</div>
      <p>Métricas evaluadas sobre el conjunto de prueba con Ground Truth estricto. Se calculan las matrices de confusión individuales.</p>

      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Método Evaluado</th>
              <th>Tipo de Enfoque</th>
              <th>Precisión</th>
              <th>Recall</th>
              <th>$F_1$-Score</th>
              <th>Falsos Positivos ($FP$)</th>
              <th>Falsos Negativos ($FN$)</th>
              <th>Verdaderos Positivos ($VP$)</th>
              <th>Verdaderos Negativos ($VN$)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>Reglas Heurísticas WAF</b></td>
              <td>Reglas / Umbrales Fijos</td>
              <td><span class="badge-val <%= metricas.alerta_reglas.precision >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_reglas.precision * 100).toFixed(1) %>%</span></td>
              <td><span class="badge-val <%= metricas.alerta_reglas.recall >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_reglas.recall * 100).toFixed(1) %>%</span></td>
              <td><b><%= metricas.alerta_reglas.f1.toFixed(3) %></b></td>
              <td><%= metricas.alerta_reglas.falsos_positivos %></td>
              <td><b style="color: var(--status-danger);"><%= metricas.alerta_reglas.falsos_negativos %></b></td>
              <td><%= metricas.alerta_reglas.verdaderos_positivos %></td>
              <td><%= metricas.alerta_reglas.verdaderos_negativos %></td>
            </tr>
            <tr>
              <td><b>Isolation Forest</b></td>
              <td>ML no supervisado (Partición)</td>
              <td><span class="badge-val <%= metricas.alerta_iforest.precision >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_iforest.precision * 100).toFixed(1) %>%</span></td>
              <td><span class="badge-val <%= metricas.alerta_iforest.recall >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_iforest.recall * 100).toFixed(1) %>%</span></td>
              <td><b><%= metricas.alerta_iforest.f1.toFixed(3) %></b></td>
              <td><%= metricas.alerta_iforest.falsos_positivos %></td>
              <td><b><%= metricas.alerta_iforest.falsos_negativos %></b></td>
              <td><%= metricas.alerta_iforest.verdaderos_positivos %></td>
              <td><%= metricas.alerta_iforest.verdaderos_negativos %></td>
            </tr>
            <tr>
              <td><b>One-Class SVM</b></td>
              <td>ML no supervisado (Frontera)</td>
              <td><span class="badge-val <%= metricas.alerta_ocsvm.precision >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_ocsvm.precision * 100).toFixed(1) %>%</span></td>
              <td><span class="badge-val <%= metricas.alerta_ocsvm.recall >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_ocsvm.recall * 100).toFixed(1) %>%</span></td>
              <td><b><%= metricas.alerta_ocsvm.f1.toFixed(3) %></b></td>
              <td><%= metricas.alerta_ocsvm.falsos_positivos %></td>
              <td><b><%= metricas.alerta_ocsvm.falsos_negativos %></b></td>
              <td><%= metricas.alerta_ocsvm.verdaderos_positivos %></td>
              <td><%= metricas.alerta_ocsvm.verdaderos_negativos %></td>
            </tr>
            <tr>
              <td><b>Local Outlier Factor (LOF)</b></td>
              <td>ML no supervisado (Densidad)</td>
              <td><span class="badge-val <%= metricas.alerta_lof.precision >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_lof.precision * 100).toFixed(1) %>%</span></td>
              <td><span class="badge-val <%= metricas.alerta_lof.recall >= 0.9 ? 'high' : 'med' %>"><%= (metricas.alerta_lof.recall * 100).toFixed(1) %>%</span></td>
              <td><b><%= metricas.alerta_lof.f1.toFixed(3) %></b></td>
              <td><%= metricas.alerta_lof.falsos_positivos %></td>
              <td><b><%= metricas.alerta_lof.falsos_negativos %></b></td>
              <td><%= metricas.alerta_lof.verdaderos_positivos %></td>
              <td><%= metricas.alerta_lof.verdaderos_negativos %></td>
            </tr>
            <tr class="highlight-row">
              <td><b>⭐ Ensamble ML Completo</b></td>
              <td>Ensamble Multi-Algoritmo</td>
              <td><span class="badge-val high"><%= (metricas.alerta_ml.precision * 100).toFixed(1) %>%</span></td>
              <td><span class="badge-val high"><%= (metricas.alerta_ml.recall * 100).toFixed(1) %>%</span></td>
              <td><b style="color: #06B6D4;"><%= metricas.alerta_ml.f1.toFixed(3) %></b></td>
              <td><%= metricas.alerta_ml.falsos_positivos %></td>
              <td><b style="color: #34D399;"><%= metricas.alerta_ml.falsos_negativos %></b></td>
              <td><%= metricas.alerta_ml.verdaderos_positivos %></td>
              <td><%= metricas.alerta_ml.verdaderos_negativos %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SECCIÓN 3: CÓDIGO LATEX LISTO PARA EL PAPER -->
    <div class="section">
      <div class="section-title">3. Tabla en formato LaTeX (Copia directa)</div>
      <p>Inserta este fragmento directamente en tu documento Overleaf o archivo <code>.tex</code>:</p>
      
      <div class="code-box">
        <button class="copy-btn" onclick="copiarLatex()">Copiar LaTeX</button>
<span id="latex-code">\begin{table}[htbp]
\centering
\begin{tabular}{|l|c|c|c|c|c|}
\hline
\textbf{Método Evaluado} & \textbf{Precisión} & \textbf{Recall} & \textbf{F1-Score} & \textbf{FP} & \textbf{FN} \\
\hline
Reglas Heurísticas WAF   & <%= metricas.alerta_reglas.precision.toFixed(3) %> & <%= metricas.alerta_reglas.recall.toFixed(3) %> & <%= metricas.alerta_reglas.f1.toFixed(3) %> & <%= metricas.alerta_reglas.falsos_positivos %> & <%= metricas.alerta_reglas.falsos_negativos %> \\
Isolation Forest (ML)    & <%= metricas.alerta_iforest.precision.toFixed(3) %> & <%= metricas.alerta_iforest.recall.toFixed(3) %> & <%= metricas.alerta_iforest.f1.toFixed(3) %> & <%= metricas.alerta_iforest.falsos_positivos %> & <%= metricas.alerta_iforest.falsos_negativos %> \\
One-Class SVM (ML)       & <%= metricas.alerta_ocsvm.precision.toFixed(3) %> & <%= metricas.alerta_ocsvm.recall.toFixed(3) %> & <%= metricas.alerta_ocsvm.f1.toFixed(3) %> & <%= metricas.alerta_ocsvm.falsos_positivos %> & <%= metricas.alerta_ocsvm.falsos_negativos %> \\
Local Outlier Factor (ML)& <%= metricas.alerta_lof.precision.toFixed(3) %> & <%= metricas.alerta_lof.recall.toFixed(3) %> & <%= metricas.alerta_lof.f1.toFixed(3) %> & <%= metricas.alerta_lof.falsos_positivos %> & <%= metricas.alerta_lof.falsos_negativos %> \\
\textbf{Ensamble ML Propuesto} & \textbf{<%= metricas.alerta_ml.precision.toFixed(3) %>} & \textbf{<%= metricas.alerta_ml.recall.toFixed(3) %>} & \textbf{<%= metricas.alerta_ml.f1.toFixed(3) %>} & <%= metricas.alerta_ml.falsos_positivos %> & \textbf{<%= metricas.alerta_ml.falsos_negativos %>} \\
\hline
\end{tabular}
\caption{Comparativa experimental de rendimiento frente a ataques volumétricos, sigilosos y distribuidos ($N = <%= totalIntentos %>$). Baseline: CICIDS2017.}
\label{tab:centinela_benchmark}
\end{table}</span>
      </div>
    </div>

    <!-- SECCIÓN 4: DISCUSIÓN CIENTÍFICA -->
    <div class="section">
      <div class="section-title">4. Hallazgos e Interpretación Científica</div>
      <p>Texto analítico sugerido para la sección de <i>Discusión de Resultados</i> de tu artículo:</p>

      <div class="callout">
        <b>Conclusión Clave:</b> La evaluación empírica demuestra que mientras las reglas deterministas tradicionales son efectivas frente a ataques volumétricos convencionales, sufren de degradación frente a vectores sigilosos (<i>low-and-slow</i>) y distribuidos, resultando en <b><%= metricas.alerta_reglas.falsos_negativos %> falsos negativos</b>. 
        <br><br>
        Por el contrario, los modelos no supervisados calibrados con los flujos de <b>CICIDS2017</b> identifican con éxito las anomalías estadísticas en los intervalos de inter-llegada (<i>IAT</i>) y dispersión de cuentas atacadas, permitiendo que el <b>Ensamble ML alcance un Recall de <%= (metricas.alerta_ml.recall * 100).toFixed(1) %>%</b> con un F1-Score de <b><%= metricas.alerta_ml.f1.toFixed(3) %></b>.
      </div>
    </div>

    <% } %>

  </div>

</div>

<% if (metricas) { %>
<script>
  // Gráfica de Barras
  const ctxBar = document.getElementById('barChart').getContext('2d');
  new Chart(ctxBar, {
    type: 'bar',
    data: {
      labels: ['Reglas WAF', 'Isolation Forest', 'OC-SVM', 'LOF', 'Ensamble ML'],
      datasets: [
        {
          label: 'Precisión',
          data: [
            <%= metricas.alerta_reglas.precision %>,
            <%= metricas.alerta_iforest.precision %>,
            <%= metricas.alerta_ocsvm.precision %>,
            <%= metricas.alerta_lof.precision %>,
            <%= metricas.alerta_ml.precision %>
          ],
          backgroundColor: 'rgba(59, 130, 246, 0.75)',
          borderRadius: 4
        },
        {
          label: 'Recall',
          data: [
            <%= metricas.alerta_reglas.recall %>,
            <%= metricas.alerta_iforest.recall %>,
            <%= metricas.alerta_ocsvm.recall %>,
            <%= metricas.alerta_lof.recall %>,
            <%= metricas.alerta_ml.recall %>
          ],
          backgroundColor: 'rgba(16, 185, 129, 0.75)',
          borderRadius: 4
        },
        {
          label: 'F1-Score',
          data: [
            <%= metricas.alerta_reglas.f1 %>,
            <%= metricas.alerta_iforest.f1 %>,
            <%= metricas.alerta_ocsvm.f1 %>,
            <%= metricas.alerta_lof.f1 %>,
            <%= metricas.alerta_ml.f1 %>
          ],
          backgroundColor: 'rgba(6, 182, 212, 0.85)',
          borderRadius: 4
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          min: 0,
          max: 1.05,
          ticks: { color: '#9CA3AF' },
          grid: { color: 'rgba(255,255,255,0.06)' }
        },
        x: {
          ticks: { color: '#9CA3AF' },
          grid: { display: false }
        }
      },
      plugins: {
        legend: {
          labels: { color: '#F3F4F6', boxWidth: 12 }
        }
      }
    }
  });

  // Gráfica de Distribución
  const ctxPie = document.getElementById('pieChart').getContext('2d');
  new Chart(ctxPie, {
    type: 'doughnut',
    data: {
      labels: ['Legítimo (Control)', 'Ráfaga Rápida', 'Low-and-Slow', 'Botnet Distribuida'],
      datasets: [{
        data: [
          <%= desglose.legitimo %>,
          <%= desglose.rapido %>,
          <%= desglose.lento %>,
          <%= desglose.distribuido %>
        ],
        backgroundColor: [
          '#10B981',
          '#EF4444',
          '#F59E0B',
          '#8B5CF6'
        ],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: '#9CA3AF', boxWidth: 10, font: { size: 10 } }
        }
      }
    }
  });

  function copiarLatex() {
    const code = document.getElementById('latex-code').innerText;
    navigator.clipboard.writeText(code).then(() => {
      alert('Código LaTeX copiado al portapapeles');
    });
  }
</script>
<% } %>

</body>
</html>
