<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login con 2FA — Doble Factor de Autenticación</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0A0E14;
    --bg-panel: #0F141C;
    --bg-panel-raised: #141B25;
    --line: #22303F;
    --text: #D6E1EA;
    --text-dim: #6E828F;
    --safe: #6FCF97;
    --warn: #FFB454;
    --danger: #F07178;
    --accent: #39BAE6;
    --font-head: 'Space Grotesk', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: var(--bg); color: var(--text); font-family: var(--font-mono);
    min-height: 100vh; display:flex; align-items:center; justify-content:center;
    padding: 24px; flex-direction: column;
  }
  .nav-header{
    position: fixed; top: 16px; left: 20px; right: 20px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 10px;
  }
  .badge-sitio{
    font-size: 11px; color: var(--text-dim);
    border: 1px solid var(--line); padding: 5px 12px; border-radius: 4px;
    background: var(--bg-panel);
    display: flex; align-items: center; gap: 8px;
  }
  .badge-proteccion{
    font-size: 11px; color: var(--accent);
    border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px;
    background: var(--bg-panel);
    display:flex; align-items:center; gap:6px;
  }
  .card{
    width: 100%; max-width: 440px;
    background: var(--bg-panel); border: 1px solid rgba(57,186,230,0.4); border-radius: 8px;
    padding: 32px 28px; margin-top: 60px;
    box-shadow: 0 0 25px rgba(57,186,230,0.08);
  }
  .nivel-tag{
    display: inline-block; font-size: 10px; font-weight: 700;
    background: rgba(57,186,230,0.15); color: var(--accent);
    padding: 3px 8px; border-radius: 3px; margin-bottom: 12px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .card h1{
    font-family: var(--font-head); font-size: 21px; font-weight: 700;
    margin-bottom: 6px;
  }
  .card p.sub{
    font-size: 12px; color: var(--text-dim); margin-bottom: 22px; line-height: 1.5;
  }
  .info-2fa{
    background: rgba(57,186,230,0.06); border: 1px solid rgba(57,186,230,0.25);
    padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 11.5px;
    line-height: 1.5; color: #bdeaff;
  }
  .totp-box{
    display: flex; align-items: center; justify-content: space-between;
    background: var(--bg-panel-raised); border: 1px solid var(--line);
    padding: 10px 14px; border-radius: 4px; margin-top: 8px;
  }
  .totp-code{
    font-size: 18px; font-weight: 700; letter-spacing: 4px; color: var(--safe);
  }
  .totp-timer{
    font-size: 10.5px; color: var(--text-dim);
  }
  label{ font-size: 11.5px; color: var(--text-dim); display:block; margin-bottom: 6px; }
  input{
    width: 100%; background: var(--bg-panel-raised); border: 1px solid var(--line);
    color: var(--text); font-family: var(--font-mono); font-size: 13px;
    padding: 10px 12px; border-radius: 4px; margin-bottom: 16px;
  }
  input:focus{ outline: none; border-color: var(--accent); }
  button{
    width: 100%; background: var(--accent); color: #0A0E14; border: none;
    font-family: var(--font-head); font-size: 13.5px; font-weight: 700;
    padding: 11px; border-radius: 4px; cursor: pointer; transition: opacity .15s ease;
  }
  button:hover{ opacity: 0.9; }
  button:disabled{ opacity: 0.5; cursor: not-allowed; }
  #resultado{
    margin-top: 16px; font-size: 12.5px; padding: 10px 12px; border-radius: 4px;
    display: none; line-height: 1.5;
  }
  #resultado.ok{ display:block; background: rgba(111,207,151,0.1); color: var(--safe); border: 1px solid rgba(111,207,151,0.3); }
  #resultado.fallo{ display:block; background: rgba(255,180,84,0.1); color: var(--warn); border: 1px solid rgba(255,180,84,0.3); }
  #resultado.bloqueado{ display:block; background: rgba(240,113,120,0.1); color: var(--danger); border: 1px solid rgba(240,113,120,0.3); }
  .nav-pills{
    margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
  }
  .nav-pills a{
    font-size: 11px; padding: 6px 12px; border-radius: 4px; text-decoration: none;
    border: 1px solid var(--line); background: var(--bg-panel); color: var(--text-dim);
  }
  .nav-pills a:hover, .nav-pills a.active{
    color: var(--text); border-color: var(--text-dim);
  }
  .step-2{ display: none; }
</style>
</head>
<body>

<div class="nav-header">
  <div class="badge-sitio">
    demo_2fa
    <a href="/" style="color:var(--safe); text-decoration:none; margin-left:8px;">← Panel de Centinela</a>
  </div>
  <div class="badge-proteccion">🔐 DOBLE FACTOR DE AUTENTICACIÓN (2FA)</div>
</div>

<div class="card">
  <div class="nivel-tag">Escenario 3 · 2FA / TOTP</div>
  <h1 id="titulo-login">Autenticación en 2 Pasos</h1>
  <p class="sub" id="sub-login">Aunque el atacante descubra la contraseña correcta, no podrá acceder sin el código del dispositivo físico (TOTP de 6 dígitos).</p>

  <!-- PASO 1: Credenciales -->
  <form id="form-paso1">
    <label for="usuario">Usuario</label>
    <input id="usuario" name="usuario" autocomplete="username" value="admin">

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="current-password" value="S3guro#2026">

    <button type="submit" id="btn-paso1">Paso 1: Validar Contraseña</button>
  </form>

  <!-- PASO 2: Código 2FA -->
  <div id="contenedor-paso2" class="step-2">
    <div class="info-2fa">
      📱 <b>Simulador de Google Authenticator:</b><br>
      Tu app móvil genera este código dinámico cada 30 segundos:
      <div class="totp-box">
        <span class="totp-code" id="codigo-simulado">482 910</span>
        <span class="totp-timer" id="timer-totp">cambia en 24s</span>
      </div>
    </div>

    <form id="form-paso2">
      <label for="codigo-2fa">Ingresa el código de 6 dígitos:</label>
      <input id="codigo-2fa" name="codigo" placeholder="Ej: 482910" maxlength="6" autocomplete="one-time-code" style="letter-spacing: 3px; font-size:16px; text-align:center;">
      <button type="submit" id="btn-paso2">Paso 2: Confirmar Ingreso con 2FA</button>
      <button type="button" id="btn-volver" style="background:transparent; border:1px solid var(--line); color:var(--text-dim); margin-top:8px;">← Volver al paso 1</button>
    </form>
  </div>

  <div id="resultado"></div>
</div>

<div class="nav-pills">
  <a href="/demo/vulnerable">1. Sin Protección</a>
  <a href="/demo/captcha">2. Con CAPTCHA</a>
  <a href="/demo/2fa" class="active" style="border-color:var(--accent); color:var(--accent);">3. Con Doble Factor (2FA)</a>
  <a href="/demo">4. Protegido por Centinela</a>
</div>

<script>
let totpActual = '';
let usuarioValidado = '';

function regenerarTOTP(){
  totpActual = Math.floor(100000 + Math.random() * 900000).toString();
  document.getElementById('codigo-simulado').textContent = totpActual.slice(0,3) + ' ' + totpActual.slice(3);
}
regenerarTOTP();
setInterval(regenerarTOTP, 30000);

// Timer countdown visual
let segundosRestantes = 30;
setInterval(() => {
  segundosRestantes--;
  if(segundosRestantes <= 0) segundosRestantes = 30;
  document.getElementById('timer-totp').textContent = `cambia en ${segundosRestantes}s`;
}, 1000);

const formPaso1 = document.getElementById('form-paso1');
const formPaso2 = document.getElementById('form-paso2');
const contenedorPaso2 = document.getElementById('contenedor-paso2');
const resultado = document.getElementById('resultado');
const btnPaso1 = document.getElementById('btn-paso1');
const btnPaso2 = document.getElementById('btn-paso2');

formPaso1.addEventListener('submit', async (e) => {
  e.preventDefault();
  const usuario = document.getElementById('usuario').value.trim();
  const password = document.getElementById('password').value;

  btnPaso1.disabled = true;
  btnPaso1.textContent = 'Verificando contraseña...';
  resultado.style.display = 'none';

  try {
    const res = await fetch('/demo/2fa/login-paso1', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({usuario, password})
    });
    const data = await res.json();

    if (res.status === 200) {
      usuarioValidado = usuario;
      formPaso1.style.display = 'none';
      contenedorPaso2.style.display = 'block';
      document.getElementById('titulo-login').textContent = 'Segundo Factor Requerido';
      document.getElementById('sub-login').textContent = `Contraseña correcta para ${usuario}. Se requiere verificación TOTP.`;
      document.getElementById('codigo-2fa').focus();
    } else {
      resultado.className = 'fallo';
      resultado.textContent = '✗ ' + data.mensaje;
      resultado.style.display = 'block';
    }
  } catch (err) {
    resultado.className = 'fallo';
    resultado.textContent = 'Error al verificar credenciales.';
    resultado.style.display = 'block';
  }

  btnPaso1.disabled = false;
  btnPaso1.textContent = 'Paso 1: Validar Contraseña';
});

formPaso2.addEventListener('submit', async (e) => {
  e.preventDefault();
  const codigo = document.getElementById('codigo-2fa').value.trim();

  btnPaso2.disabled = true;
  btnPaso2.textContent = 'Validando 2FA...';
  resultado.style.display = 'none';

  try {
    const res = await fetch('/demo/2fa/login-paso2', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({usuario: usuarioValidado, codigo, codigoEsperado: totpActual})
    });
    const data = await res.json();

    if (res.status === 200) {
      resultado.className = 'ok';
      resultado.textContent = '✓ ¡Acceso completado con éxito! (Contraseña + 2FA validados)';
    } else {
      resultado.className = 'bloqueado';
      resultado.textContent = '🚫 ' + data.mensaje;
    }
    resultado.style.display = 'block';
  } catch(err) {
    resultado.className = 'fallo';
    resultado.textContent = 'Error al validar código 2FA.';
    resultado.style.display = 'block';
  }

  btnPaso2.disabled = false;
  btnPaso2.textContent = 'Paso 2: Confirmar Ingreso con 2FA';
});

document.getElementById('btn-volver').addEventListener('click', () => {
  formPaso1.style.display = 'block';
  contenedorPaso2.style.display = 'none';
  document.getElementById('titulo-login').textContent = 'Autenticación en 2 Pasos';
  resultado.style.display = 'none';
});
</script>

</body>
</html>
