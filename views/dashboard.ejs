<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Centinela · Detección de fuerza bruta en tiempo real</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0A0E14;
    --bg-panel: #0F141C;
    --bg-panel-raised: #141B25;
    --line: #22303F;
    --text: #D6E1EA;
    --text-dim: #6E828F;
    --safe: #6FCF97;
    --warn-rules: #FFB454;
    --warn-ml: #39BAE6;
    --danger: #F07178;
    --accent: #39BAE6;
    --font-head: 'Space Grotesk', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    min-height: 100vh;
  }

  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding: 18px 28px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, #0C1119 0%, #0A0E14 100%);
    gap: 20px; flex-wrap: wrap;
  }
  .brand{
    display:flex; align-items:baseline; gap:12px;
  }
  .brand .pulse{
    width:10px; height:10px; border-radius:50%;
    background: var(--safe);
    box-shadow: 0 0 0 0 rgba(111,207,151,0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse{
    0%{ box-shadow: 0 0 0 0 rgba(111,207,151,0.5);}
    70%{ box-shadow: 0 0 0 10px rgba(111,207,151,0);}
    100%{ box-shadow: 0 0 0 0 rgba(111,207,151,0);}
  }
  .brand h1{
    font-family: var(--font-head);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand span.sub{
    color: var(--text-dim);
    font-size: 12px;
  }
  .topbar .right{ display:flex; align-items:center; gap: 14px; }
  .topbar .status{
    font-size: 11px; color: var(--text-dim);
  }
  .btn-mini{
    background: var(--bg-panel-raised);
    color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    cursor: pointer;
    text-decoration: none;
  }
  .btn-mini:hover{ color: var(--text); border-color: var(--text-dim); }

  .layout{
    display:grid;
    grid-template-columns: 360px 1fr 380px;
    gap: 1px;
    background: var(--line);
    min-height: calc(100vh - 64px);
  }
  @media (max-width: 1300px){
    .layout{ grid-template-columns: 320px 1fr 340px; }
  }
  @media (max-width: 1080px){
    .layout{ grid-template-columns: 1fr 1fr; }
    .col.panel-bot{ grid-column: 1 / -1; }
  }
  @media (max-width: 720px){
    .layout{ grid-template-columns: 1fr; }
  }

  .col{ background: var(--bg); padding: 22px 24px; min-width: 0; }

  .section-title{
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
    display: flex; justify-content: space-between; align-items: baseline;
  }
  .section-desc{
    font-size: 11.5px;
    color: var(--text-dim);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  /* ================== BOT PANEL (izquierda) ================== */
  .field{ margin-bottom: 10px; }
  .field label{
    font-size: 10.5px; color: var(--text-dim); display:block;
    margin-bottom: 5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .field select, .field input[type=number], .field input[type=text], .field textarea{
    width:100%;
    background: var(--bg-panel-raised);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 7px 10px;
    border-radius: 3px;
  }
  .field textarea{ min-height: 64px; resize: vertical; line-height: 1.45; }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline: none; border-color: var(--accent);
  }
  .row-2{ display:grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .btn{
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-panel-raised);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 9px 10px;
    cursor: pointer;
    transition: border-color .15s ease, transform .1s ease, opacity .15s;
    text-align: left;
    line-height: 1.35;
  }
  .btn:hover:not(:disabled){ border-color: var(--text-dim); }
  .btn:active:not(:disabled){ transform: scale(0.98); }
  .btn:disabled{ opacity: 0.45; cursor: not-allowed; }
  .btn.rapido{ border-left: 3px solid var(--danger); }
  .btn.lento{ border-left: 3px solid var(--warn-rules); }
  .btn.distribuido{ border-left: 3px solid var(--warn-ml); }
  .btn.lanzar-big{
    width:100%;
    background: var(--accent);
    color: #0A0E14;
    border: none;
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    margin-top: 6px;
    padding: 11px;
  }
  .btn.lanzar-big:hover{ opacity: 0.9; }
  .btn.secundario{ border-left: 3px solid var(--safe); }
  .btn.reset{ border-left: 3px solid var(--text-dim); }

  .stream-bot{
    height: 320px;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-panel);
    padding: 8px 10px;
    font-size: 11px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .stream-bot .line{ padding: 1px 0; }
  .stream-bot .line.bloqueado{ color: var(--danger); font-weight: 600; }
  .stream-bot .line.http403{ color: var(--danger); }
  .stream-bot .line.http401{ color: var(--warn-rules); }
  .stream-bot .line.http200{ color: var(--safe); }
  .stream-bot .line.http5xx{ color: #BB80E3; }
  .stream-bot .line.head{ color: var(--warn-ml); font-weight: 600; }

  /* ================== STREAM EVENTOS (centro) ================== */
  .sim-controls{
    display:grid;
    grid-template-columns: repeat(3, 1fr) 2fr 1fr;
    gap: 8px;
    margin-bottom: 20px;
  }
  @media (max-width: 1080px){
    .sim-controls{ grid-template-columns: repeat(3,1fr); }
    .sim-controls .btn.legitimo{ grid-column: span 3; }
  }

  .stream{
    height: calc(100vh - 220px);
    min-height: 480px;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-panel);
  }
  .evento{
    display:grid;
    grid-template-columns: 64px 100px 1fr 72px 72px;
    gap: 10px;
    align-items:center;
    padding: 7px 12px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    animation: entrar .25s ease;
  }
  @media (max-width: 1300px){
    .evento{ grid-template-columns: 60px 90px 1fr 64px 64px; }
  }
  @keyframes entrar{
    from{ opacity:0; transform: translateY(-4px);}
    to{ opacity:1; transform: translateY(0);}
  }
  .evento .hora{ color: var(--text-dim); font-size: 10.5px;}
  .evento .ip{ font-size: 11px; }
  .evento .detalle{ color: var(--text-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size: 11px; }
  .evento.produccion{ background: rgba(57,186,230,0.03); }
  .evento.bloqueado{ background: rgba(240,113,120,0.06); }
  .tag{
    font-size: 9.5px;
    padding: 2px 5px;
    border-radius: 3px;
    text-align:center;
    font-weight: 600;
  }
  .tag.ok{ background: rgba(111,207,151,0.12); color: var(--safe); }
  .tag.off{ background: transparent; color: var(--text-dim); border: 1px solid var(--line); }
  .tag.reglas{ background: rgba(255,180,84,0.14); color: var(--warn-rules); }
  .tag.ml{ background: rgba(57,186,230,0.14); color: var(--warn-ml); }

  /* ================== METRICAS (derecha) ================== */
  .metricas-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 14px;
  }
  .metrica-card{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 10px 10px 8px;
  }
  .metrica-card h3{
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 6px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .metrica-card.reglas h3{ color: var(--warn-rules); }
  .metrica-card.ml-iforest h3{ color: var(--warn-ml); }
  .metrica-card.ml-ocsvm h3{ color: #BB80E3; }
  .metrica-card.ml-lof h3{ color: #E6B450; }
  .metrica-card.ml-ensamble h3{ color: var(--safe); }
  .metrica-row{
    display:flex; justify-content:space-between;
    font-size: 10px;
    padding: 1.5px 0;
    color: var(--text-dim);
  }
  .metrica-row b{ color: var(--text); font-weight: 600; }
  .f1-badge{
    margin-top: 5px;
    font-size: 14.5px;
    font-weight: 700;
    font-family: var(--font-head);
  }
  .metrica-card.reglas .f1-badge{ color: var(--warn-rules); }
  .metrica-card.ml-iforest .f1-badge{ color: var(--warn-ml); }
  .metrica-card.ml-ocsvm .f1-badge{ color: #BB80E3; }
  .metrica-card.ml-lof .f1-badge{ color: #E6B450; }
  .metrica-card.ml-ensamble .f1-badge{ color: var(--safe); }

  .contador-total{
    font-size: 11px; color: var(--text-dim); margin-top: -10px; margin-bottom: 14px;
  }

  .panel-entrenamiento{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 12px 12px;
    margin-bottom: 18px;
  }
  .fila{ display:flex; gap:6px; margin-bottom:8px; }
  .fila input{ flex:1; min-width:0;
    background: var(--bg-panel-raised);
    border: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 7px 8px;
    border-radius: 3px;
  }
  .fila button{
    background: var(--bg-panel-raised);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 7px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    white-space: nowrap;
  }
  .fila button:hover{ border-color: var(--text-dim); }
  .log-entrenamiento{
    font-size: 10.5px; color: var(--text-dim); white-space: pre-line;
    max-height: 90px; overflow-y: auto; line-height: 1.5;
  }

  .panel-produccion{
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 12px 12px;
  }
  .lista-bloqueadas{
    font-size: 11px;
    max-height: 160px; overflow-y: auto;
  }
  .ip-bloqueada{
    display:flex; justify-content:space-between;
    padding: 3px 0;
  }
  .ip-bloqueada .ip{ color: var(--danger); font-weight: 600; }
  .ip-bloqueada .seg{ color: var(--text-dim); }

  .vacio{
    color: var(--text-dim);
    font-size: 11.5px;
    padding: 30px 14px;
    text-align: center;
    line-height: 1.6;
  }

  ::-webkit-scrollbar{ width: 8px; }
  ::-webkit-scrollbar-track{ background: var(--bg-panel); }
  ::-webkit-scrollbar-thumb{ background: var(--line); border-radius: 4px; }

  #toast-error{
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    background: rgba(240,113,120,0.15);
    border: 1px solid var(--danger);
    color: var(--text);
    padding: 9px 16px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    display: none;
    z-index: 9999;
  }
  #toast-error.visible{ display: block; }
</style>
</head>
<body>

<div id="toast-error"></div>

<div class="topbar">
  <div class="brand">
    <div class="pulse"></div>
    <h1>Centinela</h1>
    <span class="sub">Microservicio · /evaluar + /registrar_intento protegen cualquier login</span>
  </div>
  <div class="right">
    <div style="display:flex; align-items:center; gap:6px; background:var(--bg-panel-raised); border:1px solid var(--line); border-radius:4px; padding:4px 8px;">
      <span style="font-size:10.5px; color:var(--text-dim);">🎯 Abrir Logins:</span>
      <a href="/demo/vulnerable" target="_blank" class="btn-mini" style="color:var(--danger); border-color:rgba(240,113,120,0.4);" title="Sin defensas, vulnerable">1. Vulnerable</a>
      <a href="/demo/captcha" target="_blank" class="btn-mini" style="color:var(--warn-rules); border-color:rgba(255,180,84,0.4);" title="Con reto visual anti-bot">2. CAPTCHA</a>
      <a href="/demo/2fa" target="_blank" class="btn-mini" style="color:var(--warn-ml); border-color:rgba(57,186,230,0.4);" title="Doble factor de autenticación">3. 2FA (TOTP)</a>
      <a href="/demo" target="_blank" class="btn-mini" style="color:var(--safe); border-color:var(--safe); font-weight:600;" title="Protegido por reglas y Machine Learning">4. Centinela</a>
    </div>
    <div class="status" id="status-conexion">conectando...</div>
    <button class="btn-mini" id="btn-logout" style="display:none;">Cerrar sesión</button>
  </div>
</div>

<div class="layout">

  <!-- ================ COLUMNA 1: PANEL DEL BOT ================ -->
  <div class="col panel-bot">
    <div class="section-title">
      <span>Panel del atacante</span>
    </div>
    <div class="section-desc">
      Lanza el bot contra el login demo (<code>/demo/login</code>). Los resultados llegan al stream central vía <code>/registrar_intento</code>.
    </div>

    <div class="field">
      <label>Tipo de ataque</label>
      <select id="bot-tipo">
        <option value="rapido">Ataque rápido (1 IP, ráfaga corta)</option>
        <option value="lento">Ataque lento — low-and-slow</option>
        <option value="distribuido">Ataque distribuido (varias IPs)</option>
      </select>
    </div>

    <div class="field">
      <label>Usuario objetivo</label>
      <select id="bot-usuario">
        <option value="">(aleatorio)</option>
        <option>admin</option>
        <option>carla</option>
        <option>roberto</option>
        <option>root</option>
        <option>test</option>
      </select>
    </div>

    <div class="row-2">
      <div class="field" id="field-intentos">
        <label>N° intentos</label>
        <input type="number" id="bot-intentos" value="10" min="1" max="100">
      </div>
      <div class="field" id="field-ips" style="display:none;">
        <label>N° IPs distintas</label>
        <input type="number" id="bot-ips" value="6" min="1" max="50">
      </div>
    </div>

    <div class="row-2">
      <div class="field">
        <label>Intervalo (s)</label>
        <input type="number" step="0.1" id="bot-intervalo" value="0.3" min="0.05" max="30">
      </div>
      <div class="field">
        <label>Objetivo del Ataque</label>
        <select id="bot-url">
          <option value="/demo/login" selected>4. Centinela (WAF/ML)</option>
          <option value="/demo/vulnerable/login">1. Sin Protección</option>
          <option value="/demo/captcha/login">2. Con CAPTCHA</option>
          <option value="/demo/2fa/login-paso1">3. Con 2FA (Paso 1)</option>
        </select>
      </div>
    </div>

    <div class="field">
      <label>Contraseñas personalizadas (una por línea, opcional)</label>
      <textarea id="bot-passwords" placeholder="Deja vacío para usar la lista por defecto&#10;123456&#10;password&#10;qwerty"></textarea>
    </div>

    <button class="btn lanzar-big" id="bot-lanzar">▶ Lanzar ataque</button>

    <div style="margin-top: 16px;">
      <div class="section-title" style="font-size:12px; margin-bottom: 6px;">
        <span>Log en vivo del bot</span>
      </div>
      <div class="stream-bot" id="stream-bot">
        <div class="vacio" style="padding: 30px 10px; text-align:center;">
          Sin ataques lanzados todavía.
        </div>
      </div>
    </div>
  </div>

  <!-- ================ COLUMNA 2: STREAM EVENTOS ================ -->
  <div class="col">
    <div class="section-title">
      <span>Simulador rápido (eventos internos)</span>
    </div>
    <div class="section-desc">
      Estos botones generan tráfico simulado directo (<code>es_simulado=1</code>) para calibrar métricas rápidamente sin pasar por el login demo.
    </div>
    <div class="sim-controls">
      <button class="btn rapido" onclick="lanzarAtaque('rapido')">Ataque rápido<br><span style="color:var(--text-dim); font-size:10.5px;">ráfaga · 1 IP</span></button>
      <button class="btn lento" onclick="lanzarAtaque('lento')">Ataque lento<br><span style="color:var(--text-dim); font-size:10.5px;">low-and-slow</span></button>
      <button class="btn distribuido" onclick="lanzarAtaque('distribuido')">Ataque distrib.<br><span style="color:var(--text-dim); font-size:10.5px;">multi-IP</span></button>
      <button class="btn secundario legitimo" onclick="lanzarLegitimo()">Generar tráfico legítimo<br><span style="color:var(--text-dim); font-size:10.5px;">simula usuarios humanos</span></button>
      <button class="btn reset" onclick="resetear()">Reiniciar<br><span style="color:var(--text-dim); font-size:10.5px;">limpiar todo</span></button>
    </div>

    <div class="section-title">
      <span>Stream de intentos de login</span>
    </div>
    <div class="section-desc">
      En paralelo ambos detectores. Fondo azul = tráfico real / producción (<code>es_simulado=0</code>) · Fondo rojo = IP bloqueada en este evento.
    </div>
    <div class="stream" id="stream">
      <div class="vacio">Sin eventos todavía — lanza un ataque desde el panel izquierdo para empezar.</div>
    </div>
  </div>

  <!-- ================ COLUMNA 3: MÉTRICAS + ENTRENAMIENTO + BLOQUEOS ================ -->
  <div class="col">
    <div class="section-title"><span>Métricas comparativas</span></div>
    <div class="section-desc">Solo eventos simulados con verdad fundamental conocida.</div>
    <div class="contador-total" id="contador-total">0 intentos registrados</div>

    <div class="metricas-grid">
      <div class="metrica-card reglas">
        <h3>Reglas Fijas <span>Heurística</span></h3>
        <div class="metrica-row"><span>Precisión</span><b id="r-precision">—</b></div>
        <div class="metrica-row"><span>Recall</span><b id="r-recall">—</b></div>
        <div class="metrica-row"><span>Falsos Pos.</span><b id="r-fp">—</b></div>
        <div class="metrica-row"><span>Falsos Neg.</span><b id="r-fn">—</b></div>
        <div class="f1-badge" id="r-f1">F1 —</div>
      </div>
      <div class="metrica-card ml-iforest">
        <h3>Isolation Forest <span>Árboles</span></h3>
        <div class="metrica-row"><span>Precisión</span><b id="if-precision">—</b></div>
        <div class="metrica-row"><span>Recall</span><b id="if-recall">—</b></div>
        <div class="metrica-row"><span>Falsos Pos.</span><b id="if-fp">—</b></div>
        <div class="metrica-row"><span>Falsos Neg.</span><b id="if-fn">—</b></div>
        <div class="f1-badge" id="if-f1">F1 —</div>
      </div>
      <div class="metrica-card ml-ocsvm">
        <h3>One-Class SVM <span>Frontera RBF</span></h3>
        <div class="metrica-row"><span>Precisión</span><b id="svm-precision">—</b></div>
        <div class="metrica-row"><span>Recall</span><b id="svm-recall">—</b></div>
        <div class="metrica-row"><span>Falsos Pos.</span><b id="svm-fp">—</b></div>
        <div class="metrica-row"><span>Falsos Neg.</span><b id="svm-fn">—</b></div>
        <div class="f1-badge" id="svm-f1">F1 —</div>
      </div>
      <div class="metrica-card ml-lof">
        <h3>LOF <span>Densidad KNN</span></h3>
        <div class="metrica-row"><span>Precisión</span><b id="lof-precision">—</b></div>
        <div class="metrica-row"><span>Recall</span><b id="lof-recall">—</b></div>
        <div class="metrica-row"><span>Falsos Pos.</span><b id="lof-fp">—</b></div>
        <div class="metrica-row"><span>Falsos Neg.</span><b id="lof-fn">—</b></div>
        <div class="f1-badge" id="lof-f1">F1 —</div>
      </div>
      <div class="metrica-card ml-ensamble" style="grid-column: 1 / -1; background: rgba(111,207,151,0.06); border-color: rgba(111,207,151,0.3);">
        <h3>⭐ Ensamble Multi-ML <span>Consenso de Votación (IF + SVM + LOF)</span></h3>
        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 4px;">
          <div class="metrica-row" style="flex-direction:column;"><span>Precisión</span><b id="m-precision">—</b></div>
          <div class="metrica-row" style="flex-direction:column;"><span>Recall</span><b id="m-recall">—</b></div>
          <div class="metrica-row" style="flex-direction:column;"><span>Falsos Pos.</span><b id="m-fp">—</b></div>
          <div class="metrica-row" style="flex-direction:column;"><span>Falsos Neg.</span><b id="m-fn">—</b></div>
        </div>
        <div class="f1-badge" id="m-f1" style="margin-top: 6px;">F1 —</div>
      </div>
    </div>

    <div class="section-title"><span>Leyenda de Modelos</span></div>
    <div class="section-desc" style="margin-bottom:12px;">
      <span class="tag reglas" style="margin-right:4px;">REGLAS</span>
      <span class="tag ml" style="margin-right:4px;">IForest</span>
      <span class="tag" style="background:rgba(187,128,227,0.18); color:#BB80E3; margin-right:4px;">OC-SVM</span>
      <span class="tag" style="background:rgba(230,180,80,0.18); color:#E6B450; margin-right:4px;">LOF</span>
      <span class="tag ok">OK Éxito</span>
    </div>

    <div class="panel-entrenamiento">
      <div class="section-title" style="font-size:12px; margin-bottom:6px;">Origen de datos del entrenamiento ML</div>
      <div class="metrica-row" style="margin-bottom:6px;">
        <span>Modelo actual:</span>
        <b id="modelo-fuente" style="color:var(--warn-ml);">sintético</b>
      </div>
      <div class="section-desc" id="modelo-detalle" style="margin-bottom:10px;">
        Entrenado con datos sintéticos generados al arrancar el servidor.
      </div>
      <div class="fila" style="margin-bottom:6px;">
        <button onclick="cargarCicidsPrecargado()" style="flex:1; background:var(--accent); color:#000; font-weight:700;">⚡ Cargar CICIDS2017 (1-Click)</button>
        <button onclick="volverASintetico()" style="flex:1; border-color: var(--text-dim); color: var(--text-dim);">Reset sintético</button>
      </div>
      <div style="margin-top:8px;">
        <div style="font-size:10.5px; color:var(--text-dim); margin-bottom:4px;">O sube tus propios archivos CSV de CICIDS2017:</div>
        <div class="fila">
          <input type="file" id="in-file-cicids" accept=".csv" multiple style="font-size:10px; color:var(--text);">
          <button onclick="subirYEntrenarCicids()" style="font-size:10.5px;">Subir CSV</button>
        </div>
      </div>
      <div class="log-entrenamiento" id="log-entrenamiento"></div>
    </div>

    <div class="panel-produccion">
      <div class="section-title" style="font-size:12px; margin-bottom:6px;">Protección en vivo</div>
      <div class="section-desc" style="margin-bottom:8px;">Tráfico real (<code>/registrar_intento</code>) e IPs bloqueadas.</div>
      <div class="metrica-row"><span>Tráfico real recibido:</span><b id="prod-total">0</b></div>
      <div class="metrica-row" style="margin-bottom:10px;"><span>De ese tráfico, con alerta:</span><b id="prod-alertas">0</b></div>
      <div style="font-size:10.5px; color:var(--text-dim); margin-bottom:4px;">IPs bloqueadas activas:</div>
      <div class="lista-bloqueadas" id="lista-bloqueadas">Ninguna por ahora.</div>
    </div>
  </div>

</div>

<script>
// ================== CONEXIÓN SOCKET.IO ==================
function getCookie(name){
  const parts = `; ${document.cookie}`.split(`; ${name}=`);
  if(parts.length === 2) return parts.pop().split(';').shift();
  return '';
}

const ioOpts = { transports: ['websocket','polling'] };
const socket = io(undefined, ioOpts);

const stream = document.getElementById('stream');
const statusEl = document.getElementById('status-conexion');
let primerEvento = true;

function showToast(msg){
  const el = document.getElementById('toast-error');
  el.textContent = msg;
  el.classList.add('visible');
  setTimeout(() => el.classList.remove('visible'), 3200);
}

socket.on('connect', () => {
  statusEl.textContent = 'conectado';
  statusEl.style.color = '#6FCF97';
  actualizarProteccionEnVivo();
});
socket.on('connect_error', (err) => {
  statusEl.textContent = 'desconectado';
  statusEl.style.color = '#F07178';
  if(err && err.message && err.message.includes('401')){
    showToast('Acceso denegado: el servidor requiere autenticación.');
  }
});
socket.on('disconnect', () => {
  statusEl.textContent = 'desconectado';
  statusEl.style.color = '#F07178';
});

function formatHora(ts){
  const d = new Date(ts * 1000);
  return d.toLocaleTimeString('es-PE', {hour12:false});
}

// ================== STREAM EVENTOS ==================
socket.on('nuevo_evento', (ev) => {
  if(primerEvento){ stream.innerHTML = ''; primerEvento = false; }

  const estadoTexto = ev.exitoso ? 'éxito' : 'fallo';
  const detalle = ev.razon_reglas
    ? ev.razon_reglas
    : `${ev.usuario} · ${estadoTexto} · score_ml ${ev.score_ml}`;

  const fila = document.createElement('div');
  fila.className = 'evento';
  if(!ev.es_simulado) fila.classList.add('produccion');
  if(ev.bloqueado_ahora) fila.classList.add('bloqueado');

  const tagOk = ev.exitoso ? '<span class="tag ok" style="margin-right:4px;">OK</span>' : '';
  
  // Detalle de votos de modelos si están disponibles
  let tagsModelos = '';
  if(ev.modelos_ml){
    const ifAlerta = ev.modelos_ml.isolation_forest.alerta;
    const svmAlerta = ev.modelos_ml.one_class_svm.alerta;
    const lofAlerta = ev.modelos_ml.lof.alerta;
    tagsModelos = `
      <span class="tag ${ifAlerta ? 'ml' : 'off'}" title="Isolation Forest">${ifAlerta ? 'IF' : '—'}</span>
      <span class="tag ${svmAlerta ? 'ml' : 'off'}" style="${svmAlerta ? 'background:rgba(187,128,227,0.2); color:#BB80E3;' : ''}" title="One-Class SVM">${svmAlerta ? 'SVM' : '—'}</span>
      <span class="tag ${lofAlerta ? 'ml' : 'off'}" style="${lofAlerta ? 'background:rgba(230,180,80,0.2); color:#E6B450;' : ''}" title="LOF">${lofAlerta ? 'LOF' : '—'}</span>
    `;
  } else {
    tagsModelos = `<span class="tag ${ev.alerta_ml ? 'ml' : 'off'}">${ev.alerta_ml ? 'ML' : '—'}</span>`;
  }

  fila.innerHTML = `
    <span class="hora">${formatHora(ev.timestamp)}</span>
    <span class="ip">${ev.ip}</span>
    <span class="detalle" title="${detalle.replace(/"/g,'&quot;')}">${tagOk}${detalle}</span>
    <span class="tag ${ev.alerta_reglas ? 'reglas' : 'off'}">${ev.alerta_reglas ? 'REGLAS' : '—'}</span>
    ${tagsModelos}
  `;
  stream.prepend(fila);
  while(stream.children.length > 200){ stream.removeChild(stream.lastChild); }

  actualizarMetricas();
});

socket.on('reset', () => {
  stream.innerHTML = '<div class="vacio">Sin eventos todavía — lanza un ataque desde el panel izquierdo para empezar.</div>';
  primerEvento = true;
  actualizarMetricas();
});

// ================== SIMULADOR RÁPIDO ==================
async function lanzarAtaque(tipo){
  try{
    const res = await fetch('/simular/ataque', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({tipo})
    });
    if(res.status === 401){ showToast('Autenticación requerida para simular ataques.'); }
  } catch(e){ showToast('No se pudo conectar con el servidor.'); }
}
async function lanzarLegitimo(){
  try{
    const res = await fetch('/simular/legitimo', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({cantidad: 6})
    });
    if(res.status === 401){ showToast('Autenticación requerida.'); }
  } catch(e){ showToast('No se pudo conectar con el servidor.'); }
}
async function resetear(){
  if(!confirm('¿Reiniciar estado? (limpia eventos, bloqueos y detectores)')) return;
  try{
    await fetch('/reset', {method: 'POST'});
  } catch(e){ showToast('Error al resetear.'); }
}

// ================== MÉTRICAS ==================
function pct(x){
  if(x === undefined || x === null) return '—';
  return (x * 100).toFixed(1) + '%';
}

async function actualizarMetricas(){
  try{
    const res = await fetch('/api/metricas');
    const m = await res.json();
    if(!m){ return; }
    document.getElementById('contador-total').textContent = `${m.total_intentos} intentos registrados`;
    
    // 1. Reglas
    const r = m.alerta_reglas;
    document.getElementById('r-precision').textContent = pct(r.precision);
    document.getElementById('r-recall').textContent = pct(r.recall);
    document.getElementById('r-fp').textContent = r.falsos_positivos;
    document.getElementById('r-fn').textContent = r.falsos_negativos;
    document.getElementById('r-f1').textContent = 'F1 ' + r.f1.toFixed(3);

    // 2. Isolation Forest
    if(m.alerta_iforest){
      const iforest = m.alerta_iforest;
      document.getElementById('if-precision').textContent = pct(iforest.precision);
      document.getElementById('if-recall').textContent = pct(iforest.recall);
      document.getElementById('if-fp').textContent = iforest.falsos_positivos;
      document.getElementById('if-fn').textContent = iforest.falsos_negativos;
      document.getElementById('if-f1').textContent = 'F1 ' + iforest.f1.toFixed(3);
    }

    // 3. One-Class SVM
    if(m.alerta_ocsvm){
      const svm = m.alerta_ocsvm;
      document.getElementById('svm-precision').textContent = pct(svm.precision);
      document.getElementById('svm-recall').textContent = pct(svm.recall);
      document.getElementById('svm-fp').textContent = svm.falsos_positivos;
      document.getElementById('svm-fn').textContent = svm.falsos_negativos;
      document.getElementById('svm-f1').textContent = 'F1 ' + svm.f1.toFixed(3);
    }

    // 4. LOF
    if(m.alerta_lof){
      const lof = m.alerta_lof;
      document.getElementById('lof-precision').textContent = pct(lof.precision);
      document.getElementById('lof-recall').textContent = pct(lof.recall);
      document.getElementById('lof-fp').textContent = lof.falsos_positivos;
      document.getElementById('lof-fn').textContent = lof.falsos_negativos;
      document.getElementById('lof-f1').textContent = 'F1 ' + lof.f1.toFixed(3);
    }

    // 5. Ensamble Multi-ML
    const ml = m.alerta_ml;
    document.getElementById('m-precision').textContent = pct(ml.precision);
    document.getElementById('m-recall').textContent = pct(ml.recall);
    document.getElementById('m-fp').textContent = ml.falsos_positivos;
    document.getElementById('m-fn').textContent = ml.falsos_negativos;
    document.getElementById('m-f1').textContent = 'F1 ' + ml.f1.toFixed(3);
  } catch(e){}
}
actualizarMetricas();

async function cargarCicidsPrecargado(){
  agregarLog('Entrenando suite de modelos (Isolation Forest, OC-SVM, LOF) con dataset CICIDS2017...');
  try {
    const res = await fetch('/entrenar/cargar_cicids_precargado', {method: 'POST'});
    if(res.status === 401){
      agregarLog('Error 401: autenticación requerida.');
    } else {
      const data = await res.json();
      agregarLog(`¡Éxito! Suite entrenada con ${data.fuente}.`);
    }
  } catch(e) {
    agregarLog('Error al cargar dataset: ' + e.message);
  }
}

// ================== ENTRENAMIENTO ==================
const logEntrenamiento = document.getElementById('log-entrenamiento');
const modeloFuenteEl = document.getElementById('modelo-fuente');
const modeloDetalleEl = document.getElementById('modelo-detalle');
function agregarLog(msg){
  const hora = new Date().toLocaleTimeString('es-PE', {hour12:false});
  logEntrenamiento.textContent = `[${hora}] ${msg}\n` + logEntrenamiento.textContent;
}

async function subirYEntrenarCicids(){
  const fileInput = document.getElementById('in-file-cicids');
  if(!fileInput.files || fileInput.files.length === 0){
    agregarLog('Por favor selecciona al menos un archivo .csv desde tu computadora.');
    return;
  }
  const formData = new FormData();
  for(let i=0; i<fileInput.files.length; i++){
    formData.append('archivos', fileInput.files[i]);
  }
  formData.append('max_benignos', '5000');

  agregarLog(`Subiendo ${fileInput.files.length} archivo(s) CSV al servidor...`);
  try {
    const res = await fetch('/entrenar/upload_cicids', {
      method: 'POST',
      body: formData
    });
    const data = await res.json().catch(()=>({}));
    if(res.status === 401){
      agregarLog('Error 401: autenticación requerida.');
    } else if(!res.ok){
      agregarLog('Error: ' + (data.error || 'fallo en la subida'));
    } else {
      agregarLog(`Subida exitosa (${data.archivos_guardados} CSV). Procesando entrenamiento en segundo plano...`);
    }
  } catch(e){
    agregarLog('Error de conexión al subir archivos: ' + e.message);
  }
}

async function volverASintetico(){
  agregarLog('Volviendo al modelo entrenado con datos sintéticos...');
  const res = await fetch('/entrenar/reset_sintetico', {method: 'POST'});
  if(res.status === 401){ agregarLog('Error 401: autenticación requerida.'); }
}
socket.on('entrenamiento_progreso', (data) => agregarLog(data.mensaje));
socket.on('entrenamiento_completo', (estado) => {
  agregarLog('Entrenamiento completo.');
  modeloFuenteEl.textContent = estado.fuente === 'cicids2017' ? 'CICIDS2017 (real)' : 'sintético';
  modeloFuenteEl.style.color = estado.fuente === 'cicids2017' ? 'var(--safe)' : 'var(--warn-ml)';
  modeloDetalleEl.textContent = estado.detalle;
});
socket.on('entrenamiento_error', (data) => agregarLog('ERROR: ' + data.mensaje));

async function cargarEstadoModeloInicial(){
  const res = await fetch('/api/estado_modelo');
  const estado = await res.json();
  modeloFuenteEl.textContent = estado.fuente === 'cicids2017' ? 'CICIDS2017 (real)' : 'sintético';
  modeloFuenteEl.style.color = estado.fuente === 'cicids2017' ? 'var(--safe)' : 'var(--warn-ml)';
  modeloDetalleEl.textContent = estado.detalle;
}
cargarEstadoModeloInicial();

// ================== PROTECCIÓN EN VIVO ==================
async function actualizarProteccionEnVivo(){
  try {
    const [resBloqueadas, resProduccion] = await Promise.all([
      fetch('/api/bloqueadas'), fetch('/api/produccion')
    ]);
    const bloqueadas = await resBloqueadas.json();
    const produccion = await resProduccion.json();
    document.getElementById('prod-total').textContent = produccion.total;
    document.getElementById('prod-alertas').textContent = produccion.alertas;
    const contenedor = document.getElementById('lista-bloqueadas');
    const ips = Object.keys(bloqueadas);
    if(ips.length === 0){ contenedor.textContent = 'Ninguna por ahora.'; }
    else {
      contenedor.innerHTML = ips.map(ip =>
        `<div class="ip-bloqueada">
           <span class="ip">${ip}</span>
           <span class="seg">${bloqueadas[ip]}s restantes</span>
         </div>`
      ).join('');
    }
  } catch(e) { /* ignorar */ }
}
setInterval(actualizarProteccionEnVivo, 3000);
actualizarProteccionEnVivo();

// ================== PANEL BOT ==================
const botTipoEl = document.getElementById('bot-tipo');
const fieldIntentosEl = document.getElementById('field-intentos');
const fieldIpsEl = document.getElementById('field-ips');
const botIntervaloEl = document.getElementById('bot-intervalo');

function syncIntervaloDefault(){
  const tipo = botTipoEl.value;
  const cur = parseFloat(botIntervaloEl.value);
  if(tipo === 'rapido' && (isNaN(cur) || cur === 2.0 || cur === 0.2)) botIntervaloEl.value = '0.3';
  if(tipo === 'lento' && (isNaN(cur) || cur === 0.3 || cur === 0.2)) botIntervaloEl.value = '2.0';
  if(tipo === 'distribuido' && (isNaN(cur) || cur === 0.3 || cur === 2.0)) botIntervaloEl.value = '0.2';
}

function syncTipoFields(){
  const tipo = botTipoEl.value;
  if(tipo === 'distribuido'){
    fieldIntentosEl.style.display = 'none';
    fieldIpsEl.style.display = 'block';
  } else {
    fieldIntentosEl.style.display = 'block';
    fieldIpsEl.style.display = 'none';
  }
  syncIntervaloDefault();
}
botTipoEl.addEventListener('change', syncTipoFields);
syncTipoFields();

const streamBotEl = document.getElementById('stream-bot');
let primerBotLog = true;

function agregarBotLog(mensaje){
  if(primerBotLog){ streamBotEl.innerHTML = ''; primerBotLog = false; }
  const linea = document.createElement('div');
  linea.className = 'line';
  const t = mensaje || '';
  if(t.includes('>>> BLOQUEADO') || t.includes('BLOQUEADO en')) linea.classList.add('bloqueado');
  else if(/HTTP\s+403/.test(t)) linea.classList.add('http403');
  else if(/HTTP\s+401/.test(t)) linea.classList.add('http401');
  else if(/HTTP\s+200/.test(t)) linea.classList.add('http200');
  else if(/HTTP\s+5\d\d/.test(t)) linea.classList.add('http5xx');
  else if(/^\[ATAQUE/.test(t)) linea.classList.add('head');
  linea.textContent = t;
  streamBotEl.appendChild(linea);
  streamBotEl.scrollTop = streamBotEl.scrollHeight;
  while(streamBotEl.children.length > 600){ streamBotEl.removeChild(streamBotEl.firstChild); }
}

socket.on('bot_log', (ev) => agregarBotLog(ev.mensaje));

const botLanzarBtn = document.getElementById('bot-lanzar');
botLanzarBtn.addEventListener('click', async () => {
  const tipo = botTipoEl.value;
  const usuario = document.getElementById('bot-usuario').value || undefined;
  const intentos = parseInt(document.getElementById('bot-intentos').value,10) || 10;
  const ips = parseInt(document.getElementById('bot-ips').value,10) || 6;
  const intervalo = parseFloat(botIntervaloEl.value);
  const url = document.getElementById('bot-url').value.trim() || '/demo/login';
  const pwdRaw = document.getElementById('bot-passwords').value.trim();
  const passwords = pwdRaw ? pwdRaw.split(/\r?\n/).map(s=>s.trim()).filter(Boolean) : undefined;

  botLanzarBtn.disabled = true;
  botLanzarBtn.textContent = 'Lanzando...';

  try{
    const res = await fetch('/lanzar_bot', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({tipo, usuario, intentos, ips, intervalo, url, passwords})
    });
    const data = await res.json().catch(()=>({}));
    if(res.status === 401){
      showToast('Autenticación requerida para lanzar el bot.');
    } else if(!res.ok){
      agregarBotLog('[ERROR] ' + (data.error || `HTTP ${res.status}`));
    }
  } catch(e){
    agregarBotLog('[ERROR de conexión] No se alcanzó el servidor.');
  } finally {
    setTimeout(() => {
      botLanzarBtn.disabled = false;
      botLanzarBtn.textContent = '▶ Lanzar ataque';
    }, 600);
  }
});

// ================== LOGOUT ==================
document.getElementById('btn-logout').addEventListener('click', async () => {
  await fetch('/logout-admin', {method: 'POST'});
  location.reload();
});
if(getCookie('admin_session').length > 0){
  document.getElementById('btn-logout').style.display = 'inline-block';
}
</script>
</body>
</html>
