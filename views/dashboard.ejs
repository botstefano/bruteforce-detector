<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Centinela · Centro de Operaciones de Ciberseguridad & Anti-Bruteforce</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-base: #0B0F19;
    --bg-surface: #111827;
    --bg-surface-elevated: #1F2937;
    --bg-surface-hover: #263346;
    --border-subtle: #2D3748;
    --border-accent: #374151;
    --text-primary: #F3F4F6;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    
    --brand-primary: #06B6D4;
    --brand-primary-rgb: 6, 182, 212;
    --brand-hover: #0891B2;
    
    --status-success: #10B981;
    --status-success-bg: rgba(16, 185, 129, 0.12);
    --status-warning: #F59E0B;
    --status-warning-bg: rgba(245, 158, 11, 0.12);
    --status-danger: #EF4444;
    --status-danger-bg: rgba(239, 68, 68, 0.12);
    --status-info: #3B82F6;
    --status-info-bg: rgba(59, 130, 246, 0.12);
    --status-purple: #8B5CF6;

    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-full: 9999px;
  }

  *{ box-sizing: border-box; margin: 0; padding: 0; }
  
  body{
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* ================= NAVBAR PROFESIONAL ================= */
  .site-header{
    background: rgba(17, 24, 39, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 12px 24px;
  }
  .header-inner{
    max-width: 1720px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand-group{
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-icon{
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #06B6D4 0%, #3B82F6 100%);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px rgba(6, 182, 212, 0.35);
  }
  .brand-icon svg{
    width: 20px;
    height: 20px;
    fill: #ffffff;
  }
  .brand-info h1{
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .brand-badge{
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 7px;
    background: rgba(6, 182, 212, 0.15);
    color: var(--brand-primary);
    border-radius: var(--radius-full);
    border: 1px solid rgba(6, 182, 212, 0.3);
  }
  .brand-subtitle{
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .nav-center{
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 4px;
  }
  .nav-btn{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-secondary);
    transition: all 0.18s ease;
  }
  .nav-btn:hover{
    color: var(--text-primary);
    background: var(--bg-surface-hover);
  }
  .nav-btn.active{
    background: var(--brand-primary);
    color: #0B0F19;
    box-shadow: 0 2px 8px rgba(6, 182, 212, 0.3);
  }

  .nav-right{
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .connection-pill{
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-family: var(--font-mono);
  }
  .status-dot{
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-success);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5);
    animation: statusPulse 2s infinite;
  }
  @keyframes statusPulse{
    0%{ box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70%{ box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100%{ box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .btn-logout-pill{
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .btn-logout-pill:hover{
    color: var(--status-danger);
    border-color: var(--status-danger);
    background: var(--status-danger-bg);
  }

  /* ================= SUB-BARRA DE ESTADO / ACCESO A LOGINS ================= */
  .logins-strip{
    background: #0D1322;
    border-bottom: 1px solid var(--border-subtle);
    padding: 10px 24px;
  }
  .logins-strip-inner{
    max-width: 1720px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .logins-strip-title{
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .logins-chips{
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .login-chip{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .login-chip.vulnerable{
    background: rgba(239, 68, 68, 0.1);
    color: #F87171;
    border-color: rgba(239, 68, 68, 0.25);
  }
  .login-chip.vulnerable:hover{
    background: rgba(239, 68, 68, 0.2);
    border-color: #EF4444;
  }
  .login-chip.captcha{
    background: rgba(245, 158, 11, 0.1);
    color: #FBBF24;
    border-color: rgba(245, 158, 11, 0.25);
  }
  .login-chip.captcha:hover{
    background: rgba(245, 158, 11, 0.2);
    border-color: #F59E0B;
  }
  .login-chip.twofa{
    background: rgba(59, 130, 246, 0.1);
    color: #60A5FA;
    border-color: rgba(59, 130, 246, 0.25);
  }
  .login-chip.twofa:hover{
    background: rgba(59, 130, 246, 0.2);
    border-color: #3B82F6;
  }
  .login-chip.centinela{
    background: rgba(16, 185, 129, 0.12);
    color: #34D399;
    border-color: rgba(16, 185, 129, 0.35);
    font-weight: 700;
  }
  .login-chip.centinela:hover{
    background: rgba(16, 185, 129, 0.25);
    border-color: #10B981;
  }

  /* ================= LAYOUT DE CONTENIDO ================= */
  .main-wrapper{
    max-width: 1720px;
    width: 100%;
    margin: 0 auto;
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .grid-layout{
    display: grid;
    grid-template-columns: 390px 1fr 390px;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 1400px){
    .grid-layout{ grid-template-columns: 360px 1fr 360px; }
  }
  @media (max-width: 1160px){
    .grid-layout{ grid-template-columns: 1fr 1fr; }
    .grid-layout > .panel-bot-col{ grid-column: 1 / -1; }
  }
  @media (max-width: 780px){
    .grid-layout{ grid-template-columns: 1fr; }
    .main-wrapper{ padding: 16px; }
  }

  /* ================= TARJETAS & PANELES MODERNOS ================= */
  .card{
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card-header{
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(31, 41, 55, 0.35);
  }
  .card-header-left{
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card-icon{
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
  }
  .card-icon.red{ background: rgba(239, 68, 68, 0.15); color: #EF4444; }
  .card-icon.blue{ background: rgba(6, 182, 212, 0.15); color: var(--brand-primary); }
  .card-icon.purple{ background: rgba(139, 92, 246, 0.15); color: var(--status-purple); }
  .card-icon.green{ background: rgba(16, 185, 129, 0.15); color: var(--status-success); }
  
  .card-title{
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .card-subtitle{
    font-size: 11.5px;
    color: var(--text-muted);
    font-weight: 400;
  }
  .card-body{
    padding: 20px;
  }

  /* ================= FORMULARIOS Y CONTROLES ================= */
  .form-group{
    margin-bottom: 14px;
  }
  .form-label{
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
  }
  .form-label span.highlight{
    color: var(--brand-primary);
  }
  .form-label a{
    font-size: 11px;
    color: var(--brand-primary);
    text-decoration: none;
    font-weight: 600;
  }
  .form-label a:hover{
    text-decoration: underline;
  }
  .form-control{
    width: 100%;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 9px 12px;
    transition: all 0.2s ease;
  }
  .form-control:focus{
    outline: none;
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.18);
  }
  select.form-control{
    cursor: pointer;
  }
  textarea.form-control{
    font-family: var(--font-mono);
    font-size: 12px;
    min-height: 72px;
    resize: vertical;
    line-height: 1.5;
  }

  .form-row{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* Caja modo de ataque */
  .strategy-box{
    background: rgba(6, 182, 212, 0.04);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 16px;
  }
  .strategy-box-title{
    font-size: 12.5px;
    font-weight: 700;
    color: var(--brand-primary);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .radio-option{
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .radio-option:hover{
    background: rgba(255, 255, 255, 0.03);
  }
  .radio-option input[type="radio"]{
    margin-top: 3px;
    accent-color: var(--brand-primary);
    cursor: pointer;
    width: 16px;
    height: 16px;
  }
  .radio-option-title{
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .radio-option-desc{
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.4;
    margin-top: 2px;
  }

  .btn-primary-action{
    width: 100%;
    background: linear-gradient(135deg, #06B6D4 0%, #0284C7 100%);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    padding: 12px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
    transition: all 0.2s ease;
  }
  .btn-primary-action:hover:not(:disabled){
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(6, 182, 212, 0.45);
    background: linear-gradient(135deg, #22D3EE 0%, #0369A1 100%);
  }
  .btn-primary-action:active:not(:disabled){
    transform: translateY(0);
  }
  .btn-primary-action:disabled{
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Log de consola del bot */
  .bot-terminal{
    background: #070A11;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px;
    height: 320px;
    overflow-y: auto;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.6;
    margin-top: 10px;
  }
  .bot-terminal .line{
    padding: 1px 0;
    word-break: break-all;
  }
  .bot-terminal .line.bloqueado{ color: #F87171; font-weight: 700; }
  .bot-terminal .line.http403{ color: #EF4444; font-weight: 600; }
  .bot-terminal .line.http401{ color: #FBBF24; }
  .bot-terminal .line.http200{ color: #34D399; font-weight: 700; }
  .bot-terminal .line.http5xx{ color: #C084FC; }
  .bot-terminal .line.head{ color: #38BDF8; font-weight: 600; }

  /* ================= COLUMNA CENTRAL: STREAM DE LOGS Y SIMULADOR ================= */
  .quick-sim-buttons{
    display: grid;
    grid-template-columns: repeat(3, 1fr) 2fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  @media (max-width: 1000px){
    .quick-sim-buttons{ grid-template-columns: repeat(3, 1fr); }
    .quick-sim-buttons .btn-sim-legitimo{ grid-column: span 3; }
  }
  .btn-sim{
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    padding: 10px 12px;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .btn-sim:hover{
    background: var(--bg-surface-hover);
    border-color: var(--border-accent);
  }
  .btn-sim .sim-label{
    font-size: 12px;
    font-weight: 700;
  }
  .btn-sim .sim-sub{
    font-size: 10px;
    color: var(--text-muted);
  }
  .btn-sim.rapido{ border-left: 3px solid #EF4444; }
  .btn-sim.lento{ border-left: 3px solid #F59E0B; }
  .btn-sim.distribuido{ border-left: 3px solid #8B5CF6; }
  .btn-sim.legitimo{ border-left: 3px solid #10B981; }
  .btn-sim.reset{ border-left: 3px solid var(--text-muted); text-align: center; justify-content: center; }

  /* Stream interactivo en vivo */
  .event-stream-container{
    background: #080D17;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    height: 520px;
    overflow-y: auto;
  }
  .stream-header-row{
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: 75px 120px 1fr 70px 75px;
    gap: 10px;
    padding: 8px 14px;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .evento-row{
    display: grid;
    grid-template-columns: 75px 120px 1fr 70px 75px;
    gap: 10px;
    align-items: center;
    padding: 8px 14px;
    border-bottom: 1px solid rgba(45, 55, 72, 0.4);
    font-family: var(--font-mono);
    font-size: 11.5px;
    transition: background 0.15s ease;
    animation: slideIn 0.2s ease-out;
  }
  @keyframes slideIn{
    from{ opacity: 0; transform: translateY(-4px); }
    to{ opacity: 1; transform: translateY(0); }
  }
  .evento-row:hover{
    background: rgba(255, 255, 255, 0.02);
  }
  .evento-row.produccion{
    background: rgba(6, 182, 212, 0.04);
  }
  .evento-row.bloqueado{
    background: rgba(239, 68, 68, 0.08);
  }
  .evento-row .col-hora{ color: var(--text-muted); font-size: 11px; }
  .evento-row .col-ip{ color: var(--text-primary); font-weight: 500; }
  .evento-row .col-detalle{
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .badge{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
  }
  .badge.success{ background: var(--status-success-bg); color: #34D399; }
  .badge.warning{ background: var(--status-warning-bg); color: #FBBF24; }
  .badge.danger{ background: var(--status-danger-bg); color: #F87171; }
  .badge.info{ background: var(--status-info-bg); color: #60A5FA; }
  .badge.purple{ background: rgba(139, 92, 246, 0.15); color: #C084FC; }
  .badge.neutral{ background: rgba(255, 255, 255, 0.05); color: var(--text-muted); border: 1px solid var(--border-subtle); }

  /* ================= COLUMNA DERECHA: MÉTRICAS Y ML SUITE ================= */
  .metrics-summary-bar{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--bg-surface-elevated);
    border-radius: var(--radius-md);
    margin-bottom: 14px;
    border: 1px solid var(--border-subtle);
  }
  .metrics-summary-text{
    font-size: 12px;
    color: var(--text-secondary);
  }
  .metrics-summary-val{
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    font-family: var(--font-mono);
  }

  .metrics-cards-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }
  .metric-box{
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .metric-box-header{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .metric-box-title{
    font-size: 11.5px;
    font-weight: 700;
  }
  .metric-box-sub{
    font-size: 9.5px;
    color: var(--text-muted);
  }
  .metric-box.reglas .metric-box-title{ color: #FBBF24; }
  .metric-box.iforest .metric-box-title{ color: var(--brand-primary); }
  .metric-box.ocsvm .metric-box-title{ color: #C084FC; }
  .metric-box.lof .metric-box-title{ color: #F59E0B; }
  .metric-box.ensamble .metric-box-title{ color: #34D399; }

  .metric-stat-row{
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
    padding: 2px 0;
  }
  .metric-stat-row b{
    color: var(--text-primary);
    font-family: var(--font-mono);
  }
  .f1-score-display{
    font-size: 15px;
    font-weight: 800;
    font-family: var(--font-mono);
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .metric-box.reglas .f1-score-display{ color: #FBBF24; }
  .metric-box.iforest .f1-score-display{ color: var(--brand-primary); }
  .metric-box.ocsvm .f1-score-display{ color: #C084FC; }
  .metric-box.lof .f1-score-display{ color: #F59E0B; }
  .metric-box.ensamble .f1-score-display{ color: #34D399; }

  /* Ensamble card destacado */
  .ensemble-box{
    grid-column: 1 / -1;
    background: rgba(16, 185, 129, 0.05);
    border-color: rgba(16, 185, 129, 0.35);
  }

  /* Paneles de Control de Entrenamiento */
  .training-controls-box{
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
