<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login Vulnerable — Sin Protección</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0A0E14;
    --bg-panel: #0F141C;
    --bg-panel-raised: #141B25;
    --line: #22303F;
    --text: #D6E1EA;
    --text-dim: #6E828F;
    --safe: #6FCF97;
    --warn: #FFB454;
    --danger: #F07178;
    --accent: #F07178;
    --font-head: 'Space Grotesk', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background: var(--bg); color: var(--text); font-family: var(--font-mono);
    min-height: 100vh; display:flex; align-items:center; justify-content:center;
    padding: 24px; flex-direction: column;
  }
  .nav-header{
    position: fixed; top: 16px; left: 20px; right: 20px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 10px;
  }
  .badge-sitio{
    font-size: 11px; color: var(--text-dim);
    border: 1px solid var(--line); padding: 5px 12px; border-radius: 4px;
    background: var(--bg-panel);
    display: flex; align-items: center; gap: 8px;
  }
  .badge-proteccion{
    font-size: 11px; color: var(--danger);
    border: 1px solid var(--danger); padding: 5px 12px; border-radius: 4px;
    background: var(--bg-panel);
    display:flex; align-items:center; gap:6px;
  }
  .card{
    width: 100%; max-width: 440px;
    background: var(--bg-panel); border: 1px solid rgba(240,113,120,0.4); border-radius: 8px;
    padding: 32px 28px; margin-top: 60px;
    box-shadow: 0 0 25px rgba(240,113,120,0.08);
  }
  .nivel-tag{
    display: inline-block; font-size: 10px; font-weight: 700;
    background: rgba(240,113,120,0.15); color: var(--danger);
    padding: 3px 8px; border-radius: 3px; margin-bottom: 12px;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .card h1{
    font-family: var(--font-head); font-size: 21px; font-weight: 700;
    margin-bottom: 6px;
  }
  .card p.sub{
    font-size: 12px; color: var(--text-dim); margin-bottom: 22px; line-height: 1.5;
  }
  .warning-box{
    background: rgba(240,113,120,0.07); border: 1px dashed rgba(240,113,120,0.3);
    padding: 10px 12px; border-radius: 4px; font-size: 11px; color: #ff9e9e;
    margin-bottom: 18px; line-height: 1.5;
  }
  label{ font-size: 11.5px; color: var(--text-dim); display:block; margin-bottom: 6px; }
  input{
    width: 100%; background: var(--bg-panel-raised); border: 1px solid var(--line);
    color: var(--text); font-family: var(--font-mono); font-size: 13px;
    padding: 10px 12px; border-radius: 4px; margin-bottom: 16px;
  }
  input:focus{ outline: none; border-color: var(--danger); }
  button{
    width: 100%; background: var(--danger); color: #0A0E14; border: none;
    font-family: var(--font-head); font-size: 13.5px; font-weight: 700;
    padding: 11px; border-radius: 4px; cursor: pointer; transition: opacity .15s ease;
  }
  button:hover{ opacity: 0.9; }
  button:disabled{ opacity: 0.5; cursor: not-allowed; }
  #resultado{
    margin-top: 16px; font-size: 12.5px; padding: 10px 12px; border-radius: 4px;
    display: none; line-height: 1.5;
  }
  #resultado.ok{ display:block; background: rgba(111,207,151,0.1); color: var(--safe); border: 1px solid rgba(111,207,151,0.3); }
  #resultado.fallo{ display:block; background: rgba(255,180,84,0.1); color: var(--warn); border: 1px solid rgba(255,180,84,0.3); }
  .contador-box{
    margin-top: 18px; padding: 10px; background: var(--bg-panel-raised);
    border: 1px solid var(--line); border-radius: 4px; font-size: 11px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .nav-pills{
    margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
  }
  .nav-pills a{
    font-size: 11px; padding: 6px 12px; border-radius: 4px; text-decoration: none;
    border: 1px solid var(--line); background: var(--bg-panel); color: var(--text-dim);
  }
  .nav-pills a:hover, .nav-pills a.active{
    color: var(--text); border-color: var(--text-dim);
  }
</style>
</head>
<body>

<div class="nav-header">
  <div class="badge-sitio">
    demo_vulnerable
    <a href="/" style="color:var(--safe); text-decoration:none; margin-left:8px;">← Panel de Centinela</a>
  </div>
  <div class="badge-proteccion">⚠️ SIN PROTECCIÓN (0% DEFENSAS)</div>
</div>

<div class="card">
  <div class="nivel-tag">Escenario 1 · Vulnerable</div>
  <h1>Login Desprotegido</h1>
  <p class="sub">No tiene rate limiting, ni firewall, ni Centinela. Cada petición consulta directamente a la base de datos.</p>

  <div class="warning-box">
    ⚡ <b>Comportamiento ante ataque:</b> Un bot puede enviar 1,000 intentos continuos. El servidor responderá HTTP 401 a todos sin bloquear jamás al atacante.
  </div>

  <form id="form-login">
    <label for="usuario">Usuario</label>
    <input id="usuario" name="usuario" autocomplete="username" value="admin">

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="current-password">

    <button type="submit" id="btn-submit">Iniciar sesión (Sin filtro)</button>
  </form>

  <div id="resultado"></div>

  <div class="contador-box">
    <span>Intentos procesados por el servidor:</span>
    <b id="contador-intentos" style="color:var(--danger); font-size:13px;">0</b>
  </div>
</div>

<div class="nav-pills">
  <a href="/demo/vulnerable" class="active" style="border-color:var(--danger); color:var(--danger);">1. Sin Protección</a>
  <a href="/demo/captcha">2. Con CAPTCHA</a>
  <a href="/demo/2fa">3. Con Doble Factor (2FA)</a>
  <a href="/demo">4. Protegido por Centinela</a>
</div>

<script>
const form = document.getElementById('form-login');
const resultado = document.getElementById('resultado');
const btn = document.getElementById('btn-submit');
const contadorEl = document.getElementById('contador-intentos');
let intentosLocales = 0;

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const usuario = document.getElementById('usuario').value.trim();
  const password = document.getElementById('password').value;

  btn.disabled = true;
  btn.textContent = 'Procesando en DB...';
  resultado.className = '';
  resultado.style.display = 'none';

  try {
    const res = await fetch('/demo/vulnerable/login', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({usuario, password})
    });
    const data = await res.json();
    intentosLocales++;
    contadorEl.textContent = data.total_intentos || intentosLocales;

    if (res.status === 200) {
      resultado.className = 'ok';
      resultado.textContent = '✓ ' + data.mensaje;
    } else {
      resultado.className = 'fallo';
      resultado.textContent = '✗ ' + data.mensaje + ' (Petición procesada sin bloqueo)';
    }
  } catch (err) {
    resultado.className = 'fallo';
    resultado.textContent = 'Error al comunicarse con el servidor.';
  }

  btn.disabled = false;
  btn.textContent = 'Iniciar sesión (Sin filtro)';
});
</script>

</body>
</html>
