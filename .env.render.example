# ============================================================
# Plantilla .env PARA ENTORNO RENDER (Blueprint o servicio manual)
# Copia las variables a Render -> Environment (una por una)
# ============================================================

# === General ===
FLASK_ENV=production
PYTHONUNBUFFERED=1
SECRET_KEY=CAMBIAME_POR_UNA_CLAVE_ALEATORIA_LARGA_64_CHARS
# Cómo generar SECRET_KEY local: python -c "import secrets; print(secrets.token_urlsafe(48))"

# === Autenticación Dashboard (IMPRESCINDIBLE en producción) ===
# Si la dejas vacía -> el dashboard es PÚBLICO (cualquiera puede lanzar ataques y resetear DB)
DASHBOARD_PASSWORD=CAMBIAME_POR_TU_CONTRASEÑA_MAESTRA

# === Detección ===
DURACION_BLOQUEO_SEGUNDOS=300
SOCKETIO_ASYNC_MODE=eventlet

# === ProxyFix / IP client real (IMPRESCINDIBLE en Render) ===
# "render"     -> 2 proxys de Render x_for=2
# "cloudflare" -> x_for=1
# "" (vacío)   -> desactivado (solo localhost)
TRUSTED_PROXIES=render

# === Panel Bot: SSRF guard ===
# "0" en Render para NO permitir que el bot ataque URLs localhost/127.0.0.1 dentro del dyno
PERMITIR_LOCALHOST_BOT=0

# === Persistencia SQLite ===
# Render FREE TIER (sin disk persistente): usa ruta dentro del proyecto (efímera).
# Si pasas a plan Starter con Disk, cámbiala por: /data/centinela_eventos.db
DB_PATH=/opt/render/project/src/detector_service/data/centinela_eventos.db

# === CORS Socket.IO ===
# "*"  -> permite cualquier origen (simple para pruebas)
# "https://TU_APP.onrender.com,https://TU_DOMINIO.com" -> más seguro
ALLOWED_ORIGINS=*

# === Integración con login demo externo (solo si lo subes como otro servicio Render) ===
# LOGIN_DEMO_URL=https://tu-login-demo.onrender.com/login
